# Express auth server
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Optional local admin seed. Leave ADMIN_PASSWORD empty to skip seeding.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Supabase Postgres
# Get this from the Supabase Dashboard: Project Settings -> Database -> Connection string.
# Use the "Transaction pooler" URI for serverless-friendly pooling, or the direct/session
# connection for a long-running Express server like this one.
SUPABASE_DB_URL=

# Supabase client SDK (not required by the server's DB layer above; kept here for any
# future client-side Supabase Auth/Storage/REST usage).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# React frontend
# Leave unset for local dev: Vite proxies /api to the backend (see vite.config.js),
# which keeps the session cookie same-site. Only set this for a deployment where the
# frontend and backend are served from genuinely different origins.
# VITE_API_BASE_URL=http://localhost:4000/api
