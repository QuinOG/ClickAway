# Express auth server
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Optional local admin seed. Leave ADMIN_PASSWORD empty to skip seeding.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=clickaway

# React frontend
# Leave unset for local dev: Vite proxies /api to the backend (see vite.config.js),
# which keeps the session cookie same-site. Only set this for a deployment where the
# frontend and backend are served from genuinely different origins.
# VITE_API_BASE_URL=http://localhost:4000/api
