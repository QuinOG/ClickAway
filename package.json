{
  "name": "clickaway",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --test tests/*.test.js",
    "test:ui": "vitest run --config vitest.config.js",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test tests/e2e/visual-cohesion.spec.js --update-snapshots",
    "test:release": "npm run lint && npm run test && npm run test:browser && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@fontsource-variable/sora": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@phosphor-icons/react": "^2.1.10",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.2",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.2",
    "motion": "^12.38.0",
    "pg": "^8.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  }
}
